# =====================================================================
# PLANTILLA PÚBLICA DE VARIABLES DE ENTORNO - AUTOCOR
# ---------------------------------------------------------------------
# Este archivo SÍ se versiona y NO contiene credenciales reales.
#
# Para desplegar el sistema:
#   1. Copiar este archivo como ".env" en la raíz del proyecto
#      (PowerShell: Copy-Item .env.example .env).
#   2. Completar las credenciales de la base de datos MySQL local.
#      DB_PASSWORD debe coincidir con la clave definida para el usuario
#      'autocor_app' en el script SQL de creación de la base.
#
# El archivo .env NO debe subirse al repositorio (está en .gitignore).
# =====================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=SistemaAutocor
DB_USER=usuario_app
DB_PASSWORD=cambiar_por_una_contrasena_segura
